{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Enriched count result",
  "allOf": [
    {
      "$ref": "../../Schemas/result-common.schema.json"
    },
    {
      "properties": {
        "question_id": {
          "const": "Q9"
        },
        "answer": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "properties": {
                "display": {
                  "type": "string"
                },
                "relation": {
                  "enum": [
                    "equal",
                    "at_least",
                    "at_most",
                    "partial",
                    "contains",
                    "contained_in",
                    "unknown"
                  ]
                },
                "qualification": {
                  "type": "string"
                },
                "text": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "witness_ids": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "parameters": {
                  "type": [
                    "object",
                    "array"
                  ]
                },
                "value": {
                  "type": "string"
                },
                "formula": {
                  "type": "string"
                },
                "expression": {
                  "type": "string"
                },
                "ring": {
                  "type": "string"
                },
                "field": {
                  "type": "string"
                },
                "orientation": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      }
    }
  ]
}
